<li>Badge</li>
<li>Breadcrumb</li>
<li>Buttons - Button</li>
<li>Button group - Buttons </li>
<li>Card</li>
<li>Carousel</li>
<li>Close button - Close</li>
<li>Collapse</li>
<li>Dropdowns</li>
<li>List group - Lists</li>
<li>Modal - Dialog</li>
<li>Navbar</li>
<li>Navs &amp; tabs - Tab</li>
<li>Offcanvas</li>
<li>Pagination</li>
<li>Placeholders</li>
<li>Popovers</li>
<li>Progress</li>
<li>Scrollspy</li>
<li>Spinners</li>
<li>Toasts</li>
<li>Tooltips</li>
