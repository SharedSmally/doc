    	</restriction>
    </simpleType>    

    <simpleType name="PositionArrangeEnum">
        <annotation>
        	<documentation>Enums for Position Arrange ({property}-{position}0/50/100) via @pos </documentation>
        </annotation>
        <restriction base="string">
    		<enumeration value="top"></enumeration>
    		<enumeration value="start"></enumeration>
    		<enumeration value="bottom"></enumeration>
    		<enumeration value="end"></enumeration>
    	</restriction>
    </simpleType> 

    <simpleType name="SizingEnum">
        <annotation>
        	<documentation>Enums for Width via @w and Height via @h </documentation>
        </annotation>
        <restriction base="string">
    		<enumeration value="25"></enumeration>
    		<enumeration value="50"></enumeration>
    		<enumeration value="75"></enumeration>
    		<enumeration value="100"></enumeration>
    		<enumeration value="auto"></enumeration>
    	</restriction>
    </simpleType> 
    
    <!--  Spacing: Margin/padding 
    {property}{sides}-{breakpoint}-{size}
margin: m, mt, mb, ms, me, mx, my
padding:p, pt, pb, ps, pe, px, py

property is one of:
  m - for classes that set margin
  p - for classes that set padding
sides is one of:
  t - for classes that set margin-top or padding-top
  b - for classes that set margin-bottom or padding-bottom
  s - (start) for classes that set margin-left or padding-left in LTR, margin-right or padding-right in RTL
  e - (end) for classes that set margin-right or padding-right in LTR, margin-left or padding-left in RTL
  x - for classes that set both *-left and *-right
  y - for classes that set both *-top and *-bottom
  blank - for classes that set a margin or padding on all 4 sides of the element
    -->
    <simpleType name="SpacerEnum">
        <annotation>
        	<documentation>Enums for spacer via @w and Height via @h </documentation>
        </annotation>
        <restriction base="string">
    		<enumeration value="0"></enumeration>
    		<enumeration value="1"></enumeration>
    		<enumeration value="2"></enumeration>
    		<enumeration value="3"></enumeration>
    		<enumeration value="4"></enumeration>
    		<enumeration value="5"></enumeration>
    		<enumeration value="auto"></enumeration>
    	</restriction>
    </simpleType>


