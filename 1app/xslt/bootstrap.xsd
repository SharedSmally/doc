<!--  enums -->
    <simpleType name="BPEnum">
        <annotation>
        	<documentation>Enums for Breakpoint using attribute @bp:
        	<ul>
<li>xs(None) - Extra small</li>
<li>sm - Small</li>
<li>md - Medium</li>
<li>lg - Large</li>
<li>xl - Extra large</li>
<li>xxl - Extra extra large</li>
</ul>
</documentation>
        </annotation>
        <restriction base="string">
    		<enumeration value="xs"></enumeration>
    		<enumeration value="sm"></enumeration>
    		<enumeration value="md"></enumeration>
    		<enumeration value="lg"></enumeration>
    		<enumeration value="xl"></enumeration>
    		<enumeration value="xxl"></enumeration>
    		<enumeration value="value"></enumeration>
    	</restriction>
    </simpleType>
    <simpleType name="SizeEnum">
