    	</restriction>
    </simpleType>

    <simpleType name="FloatEnum">
        <annotation>
        	<documentation>Enums for float (float-)</documentation>
        </annotation>
        <restriction base="string">
    		<enumeration value="start"></enumeration>
    		<enumeration value="end"></enumeration>
