    	</restriction>
    </simpleType>

    <simpleType name="OverflowEnum">
        <annotation>
        	<documentation>Enums for overflow (overflow-; overflow-x-,overflow-y-) via @overflow,@overflowx,@overflowy </documentation>
        </annotation>
        <restriction base="string">
    		<enumeration value="auto"></enumeration>
    		<enumeration value="hidden"></enumeration>
    		<enumeration value="visible"></enumeration>
